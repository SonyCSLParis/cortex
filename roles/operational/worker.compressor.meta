# Cortex agent manifest — declarative single source of truth for this worker.
# Format: sourceable shell (META_* vars). Spec: roles/agent_building.md
# These fields are live: launchers, docs, and doctor checks read them directly.
# Omitted fields take the framework default. writable_paths lists the RW fence
# BEYOND the agent own dir, as symbolic anchors (never concrete private paths).

META_category=operational
META_core=yes
META_lifecycle=persistent
META_tier=medium
META_cadence=12h
META_review_timeout=default
META_use_notes=yes
META_write_capable=yes
META_writable_paths="cortex_tree"
META_owns_scripts="roles/operational/compressor/rotate_logbook.sh roles/operational/compressor/rotate_tasks_done.sh roles/operational/compressor/zip_archive_dirs.sh"
META_collaborates_with="memory cleanup security"
META_domain="logbook/task-board/archive size management via rotate/zip helpers; never rewrites live content"
